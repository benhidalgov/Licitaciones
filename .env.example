# Configuracion de Entorno: Copilot de Licitaciones y Operaciones
# Hotel Plaza San Francisco | DUOC UC

# Ticket / API Key oficial de Mercado Publico (obtenido en api.mercadopublico.cl)
MERCADO_PUBLICO_TICKET=TU_TICKET_AQUI

# Milisegundos minimos entre consultas a la API de Mercado Publico.
# La API responde HTTP 429 si se dispara. 500 ms equivale a 120 consultas/min.
# Si la sincronizacion aun recibe 429, suba este valor (700-1000).
# MERCADO_PUBLICO_INTERVALO_MS=500

# Si Python no trae la CA raiz del sitio (error CERTIFICATE_VERIFY_FAILED),
# apunte a un bundle PEM que si la incluya. Ejemplo con Git en Windows:
# MERCADO_PUBLICO_CA_BUNDLE=C:\Program Files\Git\usr\ssl\certs\ca-bundle.crt

# Clave secreta para la firma criptografica de sesiones Flask.
# En local, si queda vacia se genera una aleatoria en cada arranque.
# Para exponer el servidor es obligatoria: genere una con
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Claves de los perfiles (opcionales en local; obligatorias para exponer el servidor).
# LICITACIONES_PASSWORD_ADMIN=
# LICITACIONES_PASSWORD_DANIELA=
# LICITACIONES_PASSWORD_FRANCISCA=
# LICITACIONES_PASSWORD_MARI=

# Configuracion del servidor local
PORT=5000
HOST=127.0.0.1

# --- Opcional: Ficha Resumen generada por IA ---
# Sin estas variables el sistema usa reglas deterministicas (cero costo).
# Si configura RESUMEN_IA_API_KEY, el resumen se enriquece con el modelo y
# degrada automaticamente a reglas si la llamada falla.
# RESUMEN_IA_API_KEY=
# RESUMEN_IA_MODELO=gpt-4o-mini
# RESUMEN_IA_URL=https://api.openai.com/v1/chat/completions
