# Configuracion de Entorno: Copilot de Licitaciones y Operaciones
# Hotel Plaza San Francisco | DUOC UC

# Ticket / API Key oficial de Mercado Publico (obtenido en api.mercadopublico.cl)
MERCADO_PUBLICO_TICKET=TU_TICKET_AQUI

# Clave secreta para la firma criptografica de sesiones Flask
FLASK_SECRET_KEY=clave_secreta_institucional_desarrollo

# Configuracion del servidor local
PORT=5000
HOST=127.0.0.1

# --- Opcional: Ficha Resumen generada por IA ---
# Sin estas variables el sistema usa reglas deterministicas (cero costo).
# Si configura RESUMEN_IA_API_KEY, el resumen se enriquece con el modelo y
# degrada automaticamente a reglas si la llamada falla.
# RESUMEN_IA_API_KEY=
# RESUMEN_IA_MODELO=gpt-4o-mini
# RESUMEN_IA_URL=https://api.openai.com/v1/chat/completions
